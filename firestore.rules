rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['userId', 'displayName', 'educationLevel', 'language']) &&
        data.userId is string && data.userId == userId &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
        data.educationLevel is string && data.educationLevel.size() <= 50 &&
        data.language is string && data.language.size() <= 50 &&
        (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow delete: if isOwner(userId);
    }
  }
}
